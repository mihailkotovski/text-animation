class DexLoader:
    def __init__(self):
        self.dex_class = None
        self.dex_loader = None
        self._lock = threading.RLock()

    def start_from_bytes(self, dex_bytes: bytes) -> None:
        with self._lock:
            self.unload()
            self._verify_dex_bytes(dex_bytes)
            dex_loader = self._create_class_loader(dex_bytes)
            dex_class = dex_loader.loadClass(DEX_CLASS_NAME)
            self._verify_bridge_contract(dex_class)
            self.dex_loader = dex_loader
            self.dex_class = dex_class
            self._invoke("start")

    def _verify_dex_bytes(self, dex_bytes: bytes) -> None:
        if not dex_bytes or len(dex_bytes) < 112:
            raise RuntimeError("DEX пустой или повреждён")
        if bytes(dex_bytes[:4]) != b"dex\n":
            raise RuntimeError("Неверный DEX magic")
        digest = hashlib.sha256(dex_bytes).hexdigest().lower()
        if digest != DEX_SHA256:
            raise RuntimeError(f"DEX SHA-256 не совпадает: {digest}")

    def _create_class_loader(self, dex_bytes: bytes):
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if jclass("android.os.Build$VERSION").SDK_INT >= 26:
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            return InMemoryDexClassLoader(ByteBuffer.wrap(dex_bytes), parent)
        code_dir = context.getCodeCacheDir().getAbsolutePath()
        dex_path = os.path.join(code_dir, DEX_FILE_NAME)
        temp_path = dex_path + ".tmp"
        with open(temp_path, "wb") as file:
            file.write(dex_bytes)
        os.replace(temp_path, dex_path)
        return jclass("dalvik.system.DexClassLoader")(dex_path, code_dir, None, parent)

    def _verify_bridge_contract(self, dex_class) -> None:
        Modifier = jclass("java.lang.reflect.Modifier")
        JString = jclass("java.lang.String")
        for method_name, params in (("start", []), ("updateSettings", [JString]), ("unload", [])):
            method = dex_class.getMethod(method_name, *params)
            if not Modifier.isStatic(method.getModifiers()):
                raise RuntimeError(f"Bridge-метод {method_name} не static")

    def _invoke(self, method_name: str, *args: str):
        if self.dex_class is None:
            raise RuntimeError("DEX не загружен")
        params = [jclass("java.lang.String")] * len(args)
        return self.dex_class.getMethod(method_name, *params).invoke(None, *args)

    def update_settings(self, settings: dict[str, Any]) -> None:
        with self._lock:
            if self.dex_class is None:
                return
            self._invoke("updateSettings", json.dumps(settings, ensure_ascii=False))

    def unload(self) -> None:
        with self._lock:
            if self.dex_class is None:
                return
            try:
                self._invoke("unload")
            finally:
                self.dex_class = None
                self.dex_loader = None


class TextAnimationPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex_loader: Optional[DexLoader] = None
        self._settings_refs = []
        self._preview_generation = 0

    def _log(self, message: str) -> None:
        self.log(f"[TextAnimation] {message}")

    def _debug(self, message: str) -> None:
        if self.get_setting("debug_mode", CONFIG_DEFAULTS["debug_mode"]):
            self._log(message)

    def _is_russian(self) -> bool:
        try:
            lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
            return str(lang).startswith("ru")
        except Exception as error:
            self._debug(f"Не удалось определить язык: {error}")
            return True

    def _tr(self, ru: str, en: str) -> str:
        return ru if self._is_russian() else en

    def _collect_settings(self) -> dict[str, Any]:
        return {key: self.get_setting(key, default) for key, default in CONFIG_DEFAULTS.items()}

    def _on_setting_change(self, _new_value=None):
        self._sync_settings_to_dex()

    def _sync_settings_to_dex(self) -> None:
        if self.dex_loader is None:
            return
        try:
            self.dex_loader.update_settings(self._collect_settings())
        except Exception as error:
            self._log(f"Ошибка синхронизации настроек: {error}")

    def _load_embedded_dex(self) -> None:
        loader = DexLoader()
        try:
            loader.start_from_bytes(base64.b64decode(dex_string))
            loader.update_settings(self._collect_settings())
        except Exception as error:
            self._log(f"Ошибка загрузки встроенного DEX: {error}")
            try:
                loader.unload()
            except Exception as unload_error:
                self._log(f"Ошибка отката DEX: {unload_error}")
            return
        self.dex_loader = loader
        self._log("Встроенный DEX загружен")

    def _cleanup_legacy_cache(self) -> None:
        try:
            cache_dir = os.path.join(
                ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath(),
                LEGACY_DEX_CACHE_DIR,
            )
            if os.path.isdir(cache_dir):
                import shutil

                shutil.rmtree(cache_dir, ignore_errors=True)
                self._log("Старый DEX-кэш удалён")
        except Exception as error:
            self._debug(f"Не удалось удалить старый DEX-кэш: {error}")

    def on_plugin_load(self) -> None:
        self._log(f"Loading v{__version__}")
        self._cleanup_legacy_cache()
        self._load_embedded_dex()

    def on_plugin_unload(self) -> None:
        self._preview_generation += 1
        if self.dex_loader is not None:
            try:
                self.dex_loader.unload()
            except Exception as error:
                self._log(f"Ошибка выгрузки DEX: {error}")
            finally:
                self.dex_loader = None
        self._settings_refs = []
        self._log("Plugin unloaded")

    def _keep_settings_factory(self, factory):
        self._settings_refs.append(factory)
        return factory.instance.java

    def _setting_number(self, key: str, min_value: float, max_value: float) -> float:
        default = float(CONFIG_DEFAULTS[key])
        try:
            value = float(self.get_setting(key, default))
        except (TypeError, ValueError):
            value = default
        return max(float(min_value), min(float(max_value), value))

    def _optional(self, label: str, call) -> None:
        try:
            call()
        except Exception as error:
            self._debug(f"{label} недоступен: {error}")

    def _theme_color(self, key, resources_provider=None) -> int:
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        if resources_provider is not None:
            return Theme.getColor(key, resources_provider)
        return Theme.getColor(key)

    def _settings_text(self, context, text: str, size_dp: int, color: int, bold: bool = False):
        TextView = jclass("android.widget.TextView")
        TypedValue = jclass("android.util.TypedValue")
        AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")

        view = TextView(context)
        view.setText(str(text))
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, int(size_dp))
        view.setTextColor(color)
        if bold:
            self._optional("AndroidUtilities.bold", lambda: view.setTypeface(AndroidUtilities.bold()))
        return view

    def _preview_frames(self) -> list[tuple]:
        sample = self._tr("Печатаю красиво", "Typing smoothly")
        second_line = self._tr("И вторую строку", "And a second line")
        cut = sample.rfind(" ")
        if cut < 0:
            cut = max(0, len(sample) - 4)
        head = sample[:cut] + "\n"
        full = head + second_line

        frames = [(sample[:count], None, 190) for count in range(len(sample) + 1)]
        frames += [(sample, None, 360)] * 3
        frames += [(sample[:count], None, 210) for count in range(len(sample) - 1, cut - 1, -1)]
        frames += [(head, None, 360)] * 2
        frames += [(head + second_line[:count], None, 170) for count in range(1, len(second_line) + 1)]
        frames += [(full, (len(head), len(full)), 420)] * 5
        frames += [("", None, 480)] * 2
        return frames

    def _start_live_settings_preview(self, edit) -> None:
        plugin = self
        generation = self._preview_generation
        frames = self._preview_frames()
        run = {"token": 0}

        def tick(token: int, index: int):
            if token != run["token"] or generation != plugin._preview_generation:
                return
            try:
                text, selection, delay = frames[index]
                edit.setText(text)
                if selection is None:
                    edit.setSelection(len(text))
                else:
                    edit.setSelection(selection[0], selection[1])
                edit.requestFocus()
            except Exception as error:
                plugin._log(f"Live preview tick error: {error}")
                return
            run_on_ui_thread(lambda: tick(token, (index + 1) % len(frames)), delay=delay)

        def restart():
            run["token"] += 1
            token = run["token"]
            run_on_ui_thread(lambda: tick(token, 0), delay=350)

        AttachListener = jclass("android.view.View$OnAttachStateChangeListener")

        class _PreviewAttachListener(dynamic_proxy(AttachListener)):
            def onViewAttachedToWindow(self, view):
                restart()

            def onViewDetachedFromWindow(self, view):
                run["token"] += 1

        listener = _PreviewAttachListener()
        self._settings_refs.append(listener)
        edit.addOnAttachStateChangeListener(listener)
        if edit.isAttachedToWindow():
            restart()

    def _live_preview_factory(self):
        from ui.settings import SimpleSettingFactory

        plugin = self

        def create_view(context, list_view, current_account, class_guid, resources_provider):
            Gravity = jclass("android.view.Gravity")
            View = jclass("android.view.View")
            ViewGroupLayoutParams = jclass("android.view.ViewGroup$LayoutParams")
            LinearLayout = jclass("android.widget.LinearLayout")
            TypedValue = jclass("android.util.TypedValue")
            AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
            LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
            Theme = jclass("org.telegram.ui.ActionBar.Theme")

            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setGravity(Gravity.CENTER_VERTICAL)
            root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))
            root.setLayoutParams(ViewGroupLayoutParams(ViewGroupLayoutParams.MATCH_PARENT, ViewGroupLayoutParams.WRAP_CONTENT))

            title = plugin._settings_text(
                context,
                plugin._tr("предпросмотр", "preview"),
                16,
                plugin._theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider),
                True,
            )
            root.addView(title, LayoutHelper.createLinear(-1, -2))

            hint_color = plugin._theme_color(Theme.key_chat_messagePanelHint, resources_provider)
            edit = jclass("org.telegram.ui.Components.EditTextCaption")(context, resources_provider)
            edit.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            edit.setShowSoftInputOnFocus(False)
            edit.setSingleLine(False)
            edit.setMaxLines(2)
            edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            edit.setGravity(Gravity.LEFT | Gravity.CENTER_VERTICAL)
            edit.setPadding(0, 0, 0, 0)
            edit.setIncludeFontPadding(False)
            edit.setBackground(None)
            edit.setTextColor(plugin._theme_color(Theme.key_chat_messagePanelText, resources_provider))
            edit.setHintTextColor(hint_color)
            cursor_color = plugin._theme_color(Theme.key_chat_messagePanelCursor, resources_provider)
            hint = plugin._tr("Сообщение", "Message")
            plugin._optional("setHintColor", lambda: edit.setHintColor(hint_color))
            plugin._optional("setHintText", lambda: edit.setHintText(hint))
            plugin._optional("setCursorColor", lambda: edit.setCursorColor(cursor_color))
            plugin._optional("setCursorWidth", lambda: edit.setCursorWidth(1.5))
            plugin._optional("setCursorSize", lambda: edit.setCursorSize(AndroidUtilities.dp(24)))
            root.addView(edit, LayoutHelper.createLinear(-1, 64, 0, 8, 0, 0, 0))

            def stabilize_preview_width():
                list_width = 0
                if list_view is not None:
                    list_width = int(list_view.getMeasuredWidth() or list_view.getWidth() or 0)
                if list_width <= 0:
                    list_width = int(AndroidUtilities.displaySize.x)
                root_width = max(AndroidUtilities.dp(240), list_width)
                root.setMinimumWidth(root_width)
                edit.setMinWidth(max(1, root_width - AndroidUtilities.dp(42)))
                root.requestLayout()

            stabilize_preview_width()
            run_on_ui_thread(stabilize_preview_width, delay=80)

            plugin._start_live_settings_preview(edit)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            return None

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _slider_factory(self, key: str, title: str, min_value, max_value, suffix: str = "", decimals: int = 0):
        from ui.settings import SimpleSettingFactory

        plugin = self
        min_float = float(min_value)
        max_float = float(max_value)

        def current_value():
            return plugin._setting_number(key, min_float, max_float)

        def normalize(value):
            if decimals <= 0:
                return str(int(round(float(value))))
            return f"{float(value):.{decimals}f}"

        def format_value(value):
            text = normalize(value)
            return f"{text} {suffix}" if suffix else text

        def create_view(context, list_view, current_account, class_guid, resources_provider):
            Gravity = jclass("android.view.Gravity")
            LinearLayout = jclass("android.widget.LinearLayout")
            AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
            LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
            SeekBarView = jclass("org.telegram.ui.Components.SeekBarView")
            Theme = jclass("org.telegram.ui.ActionBar.Theme")
            accent = plugin._theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider)

            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(10), AndroidUtilities.dp(21), AndroidUtilities.dp(12))

            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)

            title_view = plugin._settings_text(
                context,
                title,
                16,
                plugin._theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider),
            )
            row.addView(title_view, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

            value_view = plugin._settings_text(context, format_value(current_value()), 14, accent, True)
            row.addView(value_view, LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))

            seek = SeekBarView(context, resources_provider)
            seek.setReportChanges(True)
            track = plugin._theme_color(Theme.key_switchTrack, resources_provider)
            plugin._optional("SeekBarView.setColors", lambda: seek.setColors(track, accent))
            root.addView(seek, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

            delegate_cls = jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate")

            class _SliderDelegate(dynamic_proxy(delegate_cls)):
                def onSeekBarDrag(self, stop, progress):
                    value = float(normalize(min_float + (max_float - min_float) * float(progress)))
                    value = max(min_float, min(max_float, value))
                    value_view.setText(format_value(value))
                    plugin.set_setting(key, normalize(value))
                    plugin._sync_settings_to_dex()

                def onSeekBarPressed(self, pressed):
                    return None

                def getContentDescription(self):
                    return f"{title}: {format_value(current_value())}"

                def getStepsCount(self):
                    return int((max_float - min_float) * (10 ** max(0, decimals)))

                def needVisuallyDivideSteps(self):
                    return False

            delegate = _SliderDelegate()
            plugin._settings_refs.append(delegate)
            seek.setDelegate(delegate)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = current_value()
            progress = 0.0 if max_float == min_float else (value - min_float) / (max_float - min_float)
            view.getChildAt(0).getChildAt(1).setText(format_value(value))
            view.getChildAt(1).setProgress(progress)

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def create_settings(self) -> list[Any]:
        on_change = self._on_setting_change
        self._preview_generation += 1
        self._settings_refs = []
        ms = self._tr("мс", "ms")

        def switch(key, title_ru, title_en, icon):
            return Switch(
                key=key,
                text=self._tr(title_ru, title_en),
                default=CONFIG_DEFAULTS[key],
                icon=icon,
                on_change=on_change,
            )

        def selector(key, title_ru, title_en, items, icon):
            return Selector(
                key=key,
                text=self._tr(title_ru, title_en),
                default=CONFIG_DEFAULTS[key],
                items=[self._tr(item_ru, item_en) for item_ru, item_en in items],
                icon=icon,
                on_change=on_change,
            )

        def slider(key, title_ru, title_en, min_value, max_value, suffix="", decimals=0):
            return Custom(factory=self._keep_settings_factory(self._slider_factory(
                key,
                self._tr(title_ru, title_en),
                min_value,
                max_value,
                suffix,
                decimals,
            )))

        return [
            Custom(factory=self._keep_settings_factory(self._live_preview_factory())),

            Header(self._tr("поведение текста", "text behavior")),
            switch("animate_all_lines", "анимировать каждую строку", "animate every line", "msg_list"),
            switch("ignore_spaces", "игнорировать пробелы", "ignore spaces", "msg_message"),
            switch("rtl_enabled", "поддержка RTL-текста", "right-to-left (RTL)", "msg_translate"),
            slider("duration", "длительность появления", "appearance duration", 80, 900, ms),
            selector(
                "easing_curve",
                "характер появления",
                "appearance curve",
                [
                    ("мягкий", "soft"),
                    ("ровный", "linear"),
                    ("плавный", "smooth"),
                    ("с перелётом", "overshoot"),
                    ("пружина", "elastic"),
                    ("отскок", "bounce"),
                ],
                "msg_speed",
            ),

            Header(self._tr("мягкое появление", "soft appearance")),
            switch("blur_enabled", "появляться из размытия", "fade in from blur", "msg_photo_blur"),
            slider("blur_duration", "длительность размытия", "blur duration", 80, 900, ms),
            slider("blur_radius", "сила размытия", "blur strength", 0, 30),
            slider("blur_text_delay", "пауза перед чётким текстом", "delay before sharp text", 0, 100, "%"),

            Header(self._tr("движение символов", "character motion")),
            switch("slide_enabled", "лёгкий въезд сверху", "slight slide from above", "msg_instant_link"),
            slider("slide_dist", "дистанция въезда", "slide distance", 0, 60, "dp"),
            switch("scale_enabled", "добавить масштаб", "add scale", "msg_zoomin"),
            slider("scale_start", "стартовый масштаб", "start scale", 0.0, 1.0, "", 1),
            switch("rotate_enabled", "чуть поворачивать буквы", "slightly rotate letters", "msg_retry"),
            slider("rotate_angle", "угол поворота", "rotation angle", -45, 45, "°"),
            switch("color_flash_enabled", "подсвечивать новые буквы цветом", "highlight new letters with color", "msg_colors"),
            slider("color_flash_strength", "яркость подсветки", "highlight brightness", 0, 100, "%"),

            Header(self._tr("вставка и отмена", "paste and undo")),
            switch("insert_wave_enabled", "вставка проявляется волной", "pasted text appears as a wave", "msg_copy"),
            slider("insert_wave_step", "шаг волны", "wave step", 0, 120, ms),
            switch("implode_enabled", "буквы собираются из частиц", "letters gather from particles", "msg_reset"),
            slider("implode_count", "частиц на сборку буквы", "particles per gathered letter", 0, 12),

            Header(self._tr("удаление текста", "text deletion")),
            switch("delete_ghost_enabled", "плавное исчезновение букв", "letters fade out smoothly", "msg_delete"),
            switch("delete_anim_enabled", "рассыпать буквы при удалении", "scatter letters when deleting", "msg_clear"),
            selector(
                "particle_style",
                "во что рассыпаются буквы",
                "what letters burst into",
                [
                    ("пыль", "dust"),
                    ("искры", "sparks"),
                    ("снежинки", "snowflakes"),
                    ("лепестки сакуры", "sakura petals"),
                    ("сами буквы", "the letters themselves"),
                    ("падающие буквы", "falling letters"),
                ],
                "weather_snowy",
            ),
            slider("particle_count", "сколько частиц с одной буквы", "particles per letter", 0, 12),
            slider("particle_speed", "как быстро разлетаются", "how fast they scatter", 0, 120),
            slider("particle_spread", "насколько широко разлетаются", "how wide they scatter", 0, 120),
            slider("particle_size", "размер частиц", "particle size", 10, 120),
