DEX_CLASS = "com.textanimation.TextAnimationCore"
DEX_FILE = "text_animation.dex"
BRIDGE_API = 1

SPEEDS = (180, 300, 450, 650)
PACES = (12, 25, 45, 70)
AMOUNTS = (3, 5, 8, 12)
CURVES = 6
STYLES = 5

PREVIEW_TAG = "text_animation_preview"
PREVIEW_START_MS = 350
PREVIEW_HEIGHT_DP = 64

DEFAULTS = {
    "speed": 1,
    "easing_curve": 0,
    "blur_enabled": True,
    "slide_enabled": True,
    "scale_enabled": False,
    "rotate_enabled": False,
    "delete_ghost_enabled": True,
    "delete_anim_enabled": True,
    "burst_style": 0,
    "burst_amount": 1,
    "send_burst_enabled": True,
    "cursor_enabled": True,
    "cursor_pace": 1,
    "cursor_blink_enabled": True,
    "liquid_cursor_enabled": False,
    "haptic_enabled": False,
}


def russian() -> bool:
    try:
        return str(LocaleController.getInstance().getCurrentLocale().getLanguage()).startswith("ru")
    except Exception:
        return True


def dex_loader(payload: bytes):
    context = ApplicationLoader.applicationContext
    parent = context.getClassLoader()
    if jclass("android.os.Build$VERSION").SDK_INT >= 26:
        return jclass("dalvik.system.InMemoryDexClassLoader")(ByteBuffer.wrap(payload), parent)
    folder = context.getCodeCacheDir().getAbsolutePath()
    path = os.path.join(folder, DEX_FILE)
    with open(path + ".tmp", "wb") as file:
        file.write(payload)
    os.replace(path + ".tmp", path)
    return jclass("dalvik.system.DexClassLoader")(path, folder, None, parent)


class Dex:
    def __init__(self):
        self.lock = threading.RLock()
        self.loader = None
        self.cls = None

    def start(self, payload: bytes):
        with self.lock:
            self.stop()
            if payload[:4] != b"dex\n" or hashlib.sha256(payload).hexdigest() != DEX_SHA256:
                raise RuntimeError("DEX повреждён")
            loader = dex_loader(payload)
            cls = loader.loadClass(DEX_CLASS)
            string = jclass("java.lang.String")
            cls.getMethod("startBridge")
            cls.getMethod("updateSettingsBridge", string)
            cls.getMethod("onUnloadBridge")
            if int(cls.getField("BRIDGE_API").getInt(None)) != BRIDGE_API:
                raise RuntimeError("несовместимое DEX-ядро")
            self.loader = loader
            self.cls = cls
            try:
                self.call("startBridge")
            except Exception:
                self.stop()
                raise

    def configure(self, settings: Dict[str, Any]):
        with self.lock:
            if self.cls is not None:
                self.call("updateSettingsBridge", json.dumps(settings, separators=(",", ":")))

    def stop(self):
        with self.lock:
            if self.cls is None:
                return
            try:
                self.call("onUnloadBridge")
            finally:
                self.loader = None
                self.cls = None

    def call(self, name: str, *args: str):
        string = jclass("java.lang.String")
        return self.cls.getMethod(name, *([string] * len(args))).invoke(None, *args)


class TextAnimationPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex()
        self.keep = []
        self.generation = 0

    def on_plugin_load(self):
        try:
            self.dex.start(base64.b64decode(DEX_BASE64))
        except Exception as error:
            self.log(f"ядро не запущено: {error}")
            return
        self.sync()

    def on_plugin_unload(self):
        self.generation += 1
        self.keep = []
        try:
            self.dex.stop()
        except Exception as error:
            self.log(f"ядро не выгружено: {error}")

    def option(self, key: str):
        return self.get_setting(key, DEFAULTS[key])

    def index(self, key: str, size: int) -> int:
        try:
            value = int(self.option(key))
        except (TypeError, ValueError):
            value = DEFAULTS[key]
        return max(0, min(size - 1, value))

    def level(self, key: str, values) -> int:
        return values[self.index(key, len(values))]

    def snapshot(self) -> Dict[str, Any]:
        return {
            "duration": self.level("speed", SPEEDS),
            "easing": self.index("easing_curve", CURVES),
            "blur": bool(self.option("blur_enabled")),
            "slide": bool(self.option("slide_enabled")),
            "scale": bool(self.option("scale_enabled")),
            "rotate": bool(self.option("rotate_enabled")),
            "ghosts": bool(self.option("delete_ghost_enabled")),
            "particles": bool(self.option("delete_anim_enabled")),
            "style": self.index("burst_style", STYLES),
            "amount": self.level("burst_amount", AMOUNTS),
            "burst": bool(self.option("send_burst_enabled")),
            "caret": bool(self.option("cursor_enabled")),
            "caret_speed": self.level("cursor_pace", PACES),
            "blink": bool(self.option("cursor_blink_enabled")),
            "liquid": bool(self.option("liquid_cursor_enabled")),
            "haptic": bool(self.option("haptic_enabled")),
        }

    def sync(self, *_):
        try:
            self.dex.configure(self.snapshot())
        except Exception as error:
            self.log(f"настройки не применены: {error}")

    def create_settings(self) -> List[Any]:
        self.generation += 1
        self.keep = []
        ru = russian()

        def tr(ru_text: str, en_text: str) -> str:
            return ru_text if ru else en_text

        def switch(key: str, ru_text: str, en_text: str, icon: str):
            return Switch(key=key, text=tr(ru_text, en_text), default=DEFAULTS[key], icon=icon, on_change=self.sync)

        def selector(key: str, ru_text: str, en_text: str, items, icon: str):
            return Selector(
                key=key,
                text=tr(ru_text, en_text),
                default=DEFAULTS[key],
                items=[tr(item_ru, item_en) for item_ru, item_en in items],
                icon=icon,
                on_change=self.sync,
            )

        return [
            Header(tr("предпросмотр", "preview")),
            self.preview(ru),
            Header(tr("появление", "appearance")),
            selector("speed", "скорость", "speed", (
                ("быстро", "fast"),
                ("обычно", "normal"),
                ("плавно", "smooth"),
                ("медленно", "slow"),
            ), "msg_speed"),
            selector("easing_curve", "характер", "curve", (
                ("мягкий", "soft"),
                ("ровный", "linear"),
                ("плавный", "smooth"),
                ("с перелётом", "overshoot"),
                ("пружина", "elastic"),
                ("отскок", "bounce"),
            ), "msg_photo_curve"),
            switch("blur_enabled", "из размытия", "from blur", "msg_photo_blur"),
            switch("slide_enabled", "въезд сверху", "slide from above", "msg_instant_link"),
            switch("scale_enabled", "рост из точки", "grow from a point", "msg_zoomin"),
            switch("rotate_enabled", "доворот", "rotate in", "msg_retry"),
            Header(tr("удаление", "deletion")),
            switch("delete_ghost_enabled", "плавное исчезновение", "fade out", "msg_delete"),
            switch("delete_anim_enabled", "рассыпание", "scatter", "msg_clear"),
            selector("burst_style", "во что рассыпаются", "scatter into", (
                ("пыль", "dust"),
                ("снежинки", "snowflakes"),
                ("лепестки сакуры", "sakura petals"),
                ("буквы", "letters"),
                ("падающие буквы", "falling letters"),
            ), "weather_snowy"),
            selector("burst_amount", "количество частиц", "particle amount", (
                ("мало", "few"),
                ("средне", "normal"),
                ("много", "many"),
                ("максимум", "maximum"),
            ), "msg_photo_settings"),
            switch("send_burst_enabled", "взрыв к кнопке отправки", "burst into send button", "msg_send"),
            Header(tr("курсор", "cursor")),
            switch("cursor_enabled", "плавный курсор", "smooth cursor", "msg_edit"),
            selector("cursor_pace", "скорость курсора", "cursor speed", (
                ("плавно", "smooth"),
                ("обычно", "normal"),
                ("быстро", "fast"),
                ("очень быстро", "very fast"),
            ), "msg_speed"),
            switch("cursor_blink_enabled", "мягкое мигание", "soft blinking", "msg_autodelete"),
            switch("liquid_cursor_enabled", "жидкий курсор", "liquid cursor", "msg_photo_curve"),
            Header(tr("отклик", "feedback")),
            switch("haptic_enabled", "вибро-отклик", "haptic feedback", "msg_notifications"),
        ]

    def preview(self, ru: bool):
        plugin = self

        def create_view(context, list_view, account, guid, provider):
            return plugin.build(context, provider, ru)

        def bind_view(view, item, divider, adapter, list_view):
            return None

        factory = SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)
        self.keep.append(factory)
        return Custom(factory=factory.instance.java)

    def build(self, context, provider, ru: bool):
        dp = AndroidUtilities.dp

        def color(key):
            return Theme.getColor(key, provider) if provider is not None else Theme.getColor(key)

        match = ViewGroup.LayoutParams.MATCH_PARENT
        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(dp(21), dp(4), dp(21), dp(4))
        root.setBackgroundColor(color(Theme.key_windowBackgroundWhite))
        root.setLayoutParams(ViewGroup.LayoutParams(match, ViewGroup.LayoutParams.WRAP_CONTENT))

        edit = EditTextCaption(context, provider)
        edit.setTag(PREVIEW_TAG)
        edit.setFocusable(False)
        edit.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
        edit.setSingleLine(False)
        edit.setMaxLines(2)
        edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
        edit.setGravity(Gravity.LEFT | Gravity.CENTER_VERTICAL)
        edit.setPadding(0, 0, 0, 0)
        edit.setBackground(None)
        edit.setTextColor(color(Theme.key_chat_messagePanelText))
        edit.setHintTextColor(color(Theme.key_chat_messagePanelHint))
        edit.setHintText("Сообщение" if ru else "Message")
        edit.setCursorColor(color(Theme.key_chat_messagePanelCursor))
        edit.setCursorWidth(1.5)
        edit.setCursorSize(dp(24))
        root.addView(edit, LinearLayout.LayoutParams(match, dp(PREVIEW_HEIGHT_DP)))

        self.play(edit, self.frames(ru))
        return root

    def play(self, edit, frames):
        plugin = self
        generation = self.generation
        state = {"token": 0}

        def tick(token: int, index: int):
            if token != state["token"] or generation != plugin.generation:
                return
            text, delay = frames[index]
            try:
                edit.setText(text)
                edit.setSelection(len(text))
            except Exception as error:
                plugin.log(f"предпросмотр остановлен: {error}")
                return
            run_on_ui_thread(lambda: tick(token, (index + 1) % len(frames)), delay=delay)

        def restart():
            state["token"] += 1
            token = state["token"]
            run_on_ui_thread(lambda: tick(token, 0), delay=PREVIEW_START_MS)

        class Watch(dynamic_proxy(View.OnAttachStateChangeListener)):
            def onViewAttachedToWindow(self, view):
                restart()

            def onViewDetachedFromWindow(self, view):
                state["token"] += 1

        watch = Watch()
        self.keep.append(watch)
        edit.addOnAttachStateChangeListener(watch)
        if edit.isAttachedToWindow():
            restart()

    @staticmethod
    def frames(ru: bool):
        first = "Печатаю красиво" if ru else "Typing smoothly"
        second = "И вторую строку" if ru else "And a second line"
        head = first[:first.rfind(" ")] + "\n"
        frames = [(first[:count], 170) for count in range(1, len(first) + 1)]
        frames.append((first, 900))
        frames += [(first[:count], 140) for count in range(len(first) - 1, len(head) - 2, -1)]
        frames += [(head + second[:count], 150) for count in range(len(second) + 1)]
        frames.append((head + second, 1100))
        frames.append(("", 1300))
        return frames


DEX_SHA256 = "6d04b7f5c888cd5e34603704f75bd833c924993581e0f316a61b6cea6e08e8ed"
DEX_BASE64 = ""
